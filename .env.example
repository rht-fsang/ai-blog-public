# ================================
# AI Blog 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值
# ================================

# ----- 必需配置 -----

# 智谱 AI API Key（用于聊天功能）
ZHIPU_API_KEY=your_zhipu_api_key

# TokenPoney API Key（用于向量嵌入）
TOKENPONEY_API_KEY=your_tokenpony_api_key

# 数据库连接字符串
# 本地开发示例：
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_blog
# 生产环境示例（Supabase）：
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# ----- 可选配置（TokenPoney）-----

# TokenPoney API URL（默认值已内置，通常无需配置）
# TOKENPONEY_API_URL=https://api.tokenpony.cn/v1

# ----- 可选配置（功能）-----

# 知识库访问密码（保护 /knowledge 页面）
# KNOWLEDGE_PASSWORD=your_password

# ----- 可选配置（站点个性化）-----

# 站点名称
# SITE_NAME=AI Blog

# 站主信息
# SITE_OWNER_NAME=Your Name
# SITE_OWNER_NICKNAME=Nickname
# SITE_OWNER_TITLE=全栈工程师 / AI 探索者
# SITE_OWNER_AVATAR=/header.jpg

# 个人简介（最多3段）
# SITE_OWNER_BIO_1=你好！我是...
# SITE_OWNER_BIO_2=我主要研究...
# SITE_OWNER_BIO_3=这里记录了...

# 技术栈（逗号分隔）
# SITE_SKILLS=TypeScript,React,Next.js,Node.js

# 联系方式
# SITE_CONTACT_WECHAT=your_wechat_id
# SITE_CONTACT_EMAIL=your@email.com
# SITE_CONTACT_GITHUB=https://github.com/yourusername
# SITE_CONTACT_TWITTER=https://twitter.com/yourusername

# AI 配置
# SITE_AI_NAME=AI
# SITE_AI_INTRO=基于知识库和博客的智能问答
# SITE_AI_SYSTEM_PROMPT=我是{name}，一名{title}...
